{
  "name": "relay-ai-inbox",
  "version": "1.0.0",
  "private": true,
  "description": "Relay – AI-powered email management for personal assistants and their clients (MERN prototype)",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/index.js",
    "seed:demo": "node server/scripts/resetDemo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
